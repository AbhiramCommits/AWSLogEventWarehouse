# Environment configuration for AWSLogEventWarehouse.
# Copy to .env and adjust. The same variables point the code at real AWS:
# leave AWS_ENDPOINT_URL empty (or unset) and provide real credentials.

# --- AWS endpoint / credentials (LocalStack defaults) -------------------------
AWS_ENDPOINT_URL=http://localhost:4566
# LocalStack community lacks the Glue + Firehose control planes and ships an
# unusably slow kinesis-mock backend, so a moto sidecar serves kinesis, glue
# and firehose locally. For real AWS leave these empty (falls back to
# AWS_ENDPOINT_URL / standard endpoints).
KINESIS_ENDPOINT_URL=http://localhost:4567
GLUE_ENDPOINT_URL=http://localhost:4567
FIREHOSE_ENDPOINT_URL=http://localhost:4567
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Buckets and streams ------------------------------------------------------
RAW_BUCKET=logwarehouse-raw
CURATED_BUCKET=logwarehouse-curated
STREAM_NAME=log-events-stream
FIREHOSE_NAME=log-events-firehose
GLUE_DATABASE=logwarehouse
ALARM_TOPIC=pipeline-alarms
LOG_GROUP=/logwarehouse/pipeline

# --- S3 key prefixes ----------------------------------------------------------
RAW_PREFIX=raw/events
CURATED_PREFIX=curated

# --- Local paths --------------------------------------------------------------
ARTIFACTS_DIR=artifacts
CURATED_LOCAL_PATH=artifacts/curated
QUARANTINE_LOCAL_PATH=artifacts/quarantine
DUCKDB_PATH=artifacts/warehouse.duckdb

# --- Producers ----------------------------------------------------------------
# 100k per source = 200,000 total events. Raise for a bigger corpus; on the
# local Kinesis mocks throughput degrades super-linearly with stream size.
APP_LOG_EVENTS=100000
CLICKSTREAM_EVENTS=100000
PUBLISH_BATCH=500
RANDOM_SEED=42

# --- Alarm thresholds (used by monitoring.alarms) -----------------------------
FRESHNESS_THRESHOLD_MINUTES=120
ROWCOUNT_FLOOR=1
ROWCOUNT_DROP_PCT=60
ERROR_RATE_THRESHOLD=0.05
QUARANTINE_RATE_THRESHOLD=0.02
